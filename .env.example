# Smart Mess System environment
# Copy to `.env` (repo root or apps/app/; apps/app wins). Never commit `.env`.
#
# Local Supabase (`supabase start`): the install scripts fill these in for you
# from `supabase status`. Cloud Supabase: Project Settings -> API.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon key or publishable key (sb_publishable_...). Either variable name works.
EXPO_PUBLIC_SUPABASE_KEY=

# Service role key. Used ONLY by local admin scripts such as `pnpm seed:dev`.
# Never put it in a client bundle or share it.
SUPABASE_SERVICE_ROLE_KEY=
